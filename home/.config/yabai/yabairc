#!/usr/bin/env sh
#
# My yabai config
#
# This is a shell script that is run by yabai when it starts up.
#
# Here are some good guides and example configs:
#  - https://d12frosted.io/posts/2022-04-23-yabai-spaces.html

# load scripting additions
sudo yabai --load-sa
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"

# Disable animations and shadows
yabai -m config window_animation_duration 0.0
yabai -m config window_animation_frame_rate 120
yabai -m config window_shadow off

# No gaps between windows
yabai -m config window_gap 0

# Reserve space for sketchybar on all displays (bar height 24 + y_offset 8)
yabai -m config external_bar all:32:0

# Mouse: cmd-drag to move/resize windows (like i3's floating_modifier)
yabai -m config mouse_modifier cmd
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize
yabai -m config mouse_drop_action swap

# Focus follows mouse like i3 (autoraise is the closest match; comment out if annoying on macOS)
# yabai -m config focus_follows_mouse autoraise

# Use BSP layout by default
yabai -m config layout bsp

# Override default layout for space 2 only
#yabai -m config --space 2 layout float

# New window spawns to the left if vertical split, or top if horizontal split
#yabai -m config window_placement first_child

# New window spawns to the right if vertical split, or bottom if horizontal split
yabai -m config window_placement second_child

# Clean up extra spaces (using actual index)
for idx in $(yabai -m query --spaces | jq '.[].index | select(. > 10)' | sort -nr); do
  yabai -m space --destroy "$idx"
done

# Ensure 10 spaces exist so the labels/bindings below always work
while [ "$(yabai -m query --spaces | jq length)" -lt 10 ]; do
  yabai -m space --create
done

# Label spaces
yabai -m space 1 --label "1 👨‍💻"  # Terminal
yabai -m space 2 --label "2 🌍"   # Browsers
yabai -m space 3 --label "3 🛠️"   # Dev
yabai -m space 4 --label "4 📝"   # Notes
yabai -m space 5 --label "5 🎵"   # Music
yabai -m space 6 --label "6 💬"   # Chat
yabai -m space 7 --label "7 📺"   # Video
yabai -m space 8 --label "8 🌈"   # Games
yabai -m space 9 --label "9 📔"   # Misc
yabai -m space 10 --label "⚙️"    # System

# Move apps to specific spaces (without focus to avoid flickering).
# Rules target space LABELS, not indices: mission-control indices reshuffle when
# displays connect/disconnect, but labels stick to the space itself.
# Terminal - Disabled because we actually want to use the terminal in multiple spaces
# yabai -m rule --add app="^Alacritty$" space=1

# Browsers
yabai -m rule --add app="^Safari$" space="2 🌍"
yabai -m rule --add app="^Firefox$" space="2 🌍"

# Dev
yabai -m rule --add app="^Code$" space="3 🛠️"
yabai -m rule --add app="^Linear$" space="3 🛠️"

# Notes
yabai -m rule --add app="^Standard Notes$" space="4 📝"
yabai -m rule --add app="^Roam Research$" space="4 📝"
yabai -m rule --add app="^Limitless$" space="4 📝"

# Music
yabai -m rule --add app="^Music$" space="5 🎵"
yabai -m rule --add app="^Spotify$" space="5 🎵"

# Chat
yabai -m rule --add app="^Discord$" space="6 💬"
yabai -m rule --add app="^Slack$" space="6 💬"

# Video
yabai -m rule --add app="^VLC$" space="7 📺"

# Games
yabai -m rule --add app="^Steam$" space="8 🌈"

# System
yabai -m rule --add app="^System Settings$" space="⚙️"
yabai -m rule --add app="^Activity Monitor$" space="⚙️"

# Move any already-open windows to their assigned spaces (rules otherwise only
# apply to windows created after yabai starts)
yabai -m rule --apply
